{
  "name": "ilife",
  "private": true,
  "version": "0.0.0",
  "description": "爱生活全 TS 重构（一期框架）monorepo",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "node --test \"test/*.test.mjs\" \"packages/base-render/test/*.test.mjs\" \"packages/skill-calorie/test/*.test.mjs\" \"packages/skill-memo/test/*.test.mjs\" \"packages/skill-schedule/test/*.test.mjs\" \"packages/skill-home/test/*.test.mjs\" \"packages/skill-bill/test/*.test.mjs\"",
    "doctor": "node tooling/skilllink.mjs doctor",
    "snapshot": "node tooling/write-snapshot.mjs",
    "snapshot:check": "node tooling/write-snapshot.mjs --check",
    "boundaries": "node tooling/check-boundaries.mjs",
    "changeset:status": "changeset status"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/node": "^26.4.1",
    "typescript": "^5.9.2"
  }
}
