#!/bin/sh
# 提交身份守卫（推送侧）：本仓推出去的每个新提交，作者与提交者都只许是用户本人
# FeatherHunter <975559549@qq.com>。
#
# 显示名 2026-10-18 由「王辰浩」（同一邮箱）改成 FeatherHunter——历史里那个旧显示名的提交
# 按本钩子的严格口径（名+邮箱）判不合规，所以把旧历史推到「目的端还没有它们」的远端时会
# 被整条点名；推到 origin 这类远端已有的部分不查，日常推送不受影响。
#
# 为什么还要这一层：commit-msg 只在 `git commit` 这条路上跑。`git cherry-pick`／
# `git rebase`／`git am` 会**保留原提交的作者**，而且它们不跑 commit-msg（2026-10-18
# 实测：cherry-pick 与 am 都 exit 0 落地、作者仍是 muse-spark@local）；`git commit-tree`
# ＋ `update-ref` 也绕开钩子。这些路子在**离开本机**这一步被这里拦下。
#
# 查哪一段：不按 remote 名字判断，只问「目的端现在已经有哪些提交」——把它已有的 ref tip
# 全部排除，剩下的才是**这次真会被带过去**的提交。于是推 origin（远端已有的那部分不查）、
# 推别的远端、以 URL 直推，走的是同一条规则；目的端一个提交都没有（空库）时排除集为空，
# 整条历史都会被查，并在报文里说明这不是误报。
#
# 两条硬要求（2026-10-18 第三轮复核实测踩出来的，别改回去）：
#   1) 排除集与候选集一律经 stdin／临时文件传递，**不拼进 argv**：目的端 ref 上千条时 argv
#      会超 Windows 32767 字符上限，`git rev-list` 直接 exit 126（Argument list too long），
#      旧版把 stderr 丢掉后候选集成了空、checked=0、静默放行了一条旧身份提交（真漏检口）。
#   2) **读不出范围就拒绝推送**（fail-closed）：ls-remote／rev-list／sort／log 任何一步非 0
#      都 exit 1。宁可拒绝，也不静默放行。
#
# 确需推旧身份提交（例如如实搬运历史）时用 `git push --no-verify`，并在 PR／提交信息里
# 写明缘由——守卫不认识「例外」，只认身份。
expected_name='FeatherHunter'
expected_email='975559549@qq.com'
zero='0000000000000000000000000000000000000000'
want="${expected_name}|${expected_email}|${expected_name}|${expected_email}"
max_show=20
remote="$1"
url="$2"
all_history=0

[ -n "$url" ] || url="$remote"

tmpd=$(mktemp -d "${TMPDIR:-/tmp}/git-prepush.XXXXXX" 2>/dev/null) || tmpd="${TMPDIR:-/tmp}/git-prepush.$$"
mkdir -p "$tmpd" || exit 1
trap 'rm -rf "$tmpd"' EXIT HUP INT TERM
cand="$tmpd/cand"; excl="$tmpd/excl"; range="$tmpd/range"; idents="$tmpd/idents"; badf="$tmpd/bad"
: > "$cand"; : > "$excl"; : > "$badf"

refuse() {
  {
    echo "提交身份守卫（tooling/git-hooks/pre-push）：$1"
    echo "守卫读不出「这次要推哪些提交」，按不放行处理（宁可拒绝，也不静默放行）。"
    echo "确认目的端可读、本机对象完整后重试；确需绕过：git push --no-verify，并在 PR／提交信息里写明缘由。"
  } >&2
  exit 1
}

# 目的端已有的 ref tip → 排除集（一行一条 `^sha`）。本机没有的 tip 交给 rev-list 的
# --ignore-missing 忽略（历史分叉时排除不掉，宁可多查不漏查）。
if ! git ls-remote --quiet --refs "$url" > "$tmpd/tips.raw" 2>"$tmpd/lsremote.err"; then
  refuse "读不到目的端（${remote}）的 refs：$(head -c 160 "$tmpd/lsremote.err" 2>/dev/null)"
fi
cut -f1 "$tmpd/tips.raw" > "$tmpd/tips"
while IFS= read -r sha; do
  [ -n "$sha" ] || continue
  printf '^%s\n' "$sha"
done < "$tmpd/tips" > "$excl"

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in "$zero") continue ;; esac          # 删远端分支：没有新提交
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    printf '%s\n' "${remote_sha}..${local_sha}" > "$range"   # 目的端已有这条 sha：只查真正新增的
  else
    cp "$excl" "$range"
    printf '%s\n' "$local_sha" >> "$range"
    [ -s "$excl" ] || all_history=1
  fi
  if ! git rev-list --ignore-missing --stdin < "$range" >> "$cand" 2>"$tmpd/revlist.err"; then
    refuse "算不出要推的提交范围（git rev-list 失败：$(head -c 160 "$tmpd/revlist.err" 2>/dev/null)）"
  fi
done

if ! sort -u "$cand" > "$cand.u" 2>"$tmpd/sort.err"; then
  refuse "候选提交去重失败（sort 失败：$(head -c 160 "$tmpd/sort.err" 2>/dev/null)）"
fi
if [ -s "$cand" ] && [ ! -s "$cand.u" ]; then
  refuse "候选提交去重后成了空集（${cand} 非空）"
fi

checked=0
badn=0
if [ -s "$cand.u" ]; then
  # 一次问完：逐个 `git log -1 <sha>` 在本机约 0.025s／条，353 条十几秒、上万条就卡住了。
  if ! git log --no-walk --stdin --format='%H|%an|%ae|%cn|%ce' < "$cand.u" > "$idents" 2>"$tmpd/log.err"; then
    refuse "读不出这些提交的身份（git log 失败：$(head -c 160 "$tmpd/log.err" 2>/dev/null)）"
  fi
  # 结果写临时文件、只累加整数：shell 字符串累加是 O(n²)，--mirror 那种上万条的推送会假卡死。
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    checked=$((checked + 1))
    case "$line" in
      *"$want") ;;
      *) printf '  %s\n' "$line" >> "$badf"; badn=$((badn + 1)) ;;
    esac
  done < "$idents"
fi

if [ "$badn" -gt 0 ]; then
  {
    echo "提交身份守卫（tooling/git-hooks/pre-push）：这次要推出去的 ${badn} 个提交（共查 ${checked} 个）里，下面这些的作者或提交者不是 ${expected_name} <${expected_email}>："
    if [ "$badn" -le "$max_show" ]; then
      cat "$badf"
    else
      head -n "$max_show" "$badf"
      echo "  ……（另有 $((badn - max_show)) 条，略）"
    fi
    if [ "$all_history" = 1 ]; then
      echo "说明：这次的目的端（${remote}）里还没有这些提交，整条历史都会被一起推过去，所以历史里的旧身份提交也一并点名——这不是误报。"
    fi
    echo "为什么会被漏到这一步：cherry-pick／rebase／am 保留原作者身份，且它们都不跑 commit-msg 守卫（本探针实测）。"
    echo "注意：这一层查的是「整条推送范围」，把末端的提交改成本人并不能洗掉下面历史里的旧身份提交。"
    echo "修法（两种都实测有效）："
    echo "  git cherry-pick --no-commit <sha> && git commit -m \"...\"        # 作者＝现在的你"
    echo "  git rebase <新底> <分支> --exec 'git commit --amend --reset-author --no-edit'   # 把范围内每条重写成你"
    echo "  （git am 同样保留原作者；它没有 --no-commit，落地后用上面那条 rebase --exec 修）"
    echo "确实要照原样推旧身份提交时：git push --no-verify，并在 PR／提交信息里写明缘由。"
  } >&2
  exit 1
fi

exit 0
