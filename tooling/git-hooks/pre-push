#!/bin/sh
# 提交身份守卫（推送侧）：本仓推出去的每个新提交，作者与提交者都只许是用户本人
# 王辰浩 <975559549@qq.com>。
#
# 为什么还要这一层：commit-msg 只在 `git commit` 这条路上跑。`git cherry-pick`／
# `git rebase`／`git am` 会**保留原提交的作者**，而且它们不跑 commit-msg（2026-10-18
# 实测：cherry-pick 与 am 都 exit 0 落地、作者仍是 muse-spark@local）；`git commit-tree`
# ＋ `update-ref` 也绕开钩子。这些路子在**离开本机**这一步被这里拦下。
#
# 确需推旧身份提交（例如如实搬运历史）时用 `git push --no-verify`，并在 PR／提交信息里
# 写明缘由——守卫不认识「例外」，只认身份。
expected_name='王辰浩'
expected_email='975559549@qq.com'
zero='0000000000000000000000000000000000000000'
bad=''
checked=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in "$zero") continue ;; esac          # 删远端分支：没有新提交
  if [ "$remote_sha" != "$zero" ] && git cat-file -e "${remote_sha}^{commit}" 2>/dev/null; then
    range="$remote_sha..$local_sha"
  elif git rev-parse --verify --quiet refs/remotes/origin >/dev/null 2>&1; then
    range="$local_sha --not --remotes=origin"             # 远端还没有这条 sha：按「origin 上没有的」算
  else
    range="$local_sha --not --remotes"
  fi
  for c in $(git rev-list $range 2>/dev/null); do
    ident=$(git log -1 --format='%an|%ae|%cn|%ce' "$c" 2>/dev/null)
    checked=$((checked + 1))
    case "$ident" in
      "${expected_name}|${expected_email}|${expected_name}|${expected_email}") ;;
      *) bad="${bad}  ${c}  ${ident}
" ;;
    esac
  done
done

if [ -n "$bad" ]; then
  {
    echo "提交身份守卫（tooling/git-hooks/pre-push）：下面这些**要推出去**的提交，作者或提交者不是 ${expected_name} <${expected_email}>："
    printf '%s' "$bad"
    echo "为什么会被漏到这一步：cherry-pick／rebase／am 保留原作者身份，且它们都不跑 commit-msg 守卫（本探针实测）。"
    echo "注意：这一层查的是「整条推送范围」，把末端的提交改成本人并不能洗掉下面历史里的旧身份提交。"
    echo "修法（两种都实测有效）："
    echo "  git cherry-pick --no-commit <sha> && git commit -m \"...\"        # 作者＝现在的你"
    echo "  git rebase <新底> <分支> --exec 'git commit --amend --reset-author --no-edit'   # 把范围内每条重写成你"
    echo "  （git am 同样保留原作者；它没有 --no-commit，落地后用上面那条 rebase --exec 修）"
    echo "确实要照原样推旧身份提交时：git push --no-verify，并在 PR／提交信息里写明缘由。"
  } >&2
  exit 1
fi

exit 0
