{
  "name": "skill-memo-ilife",
  "version": "0.3.13",
  "description": "备忘录SKILL一期：取数+口径+渲染+出口（M2/M3/M4/M5），依 link-core",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "SKILL.md",
    "templates/*.html"
  ],
  "bin": {
    "memo-cmd-read": "./dist/cli/cmd_read.js"
  },
  "dependencies": {
    "base-link-core": "0.3.13",
    "base-paint": "0.3.13"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -b && node scripts/build-help.mjs",
    "gate:lines": "node scripts/check-warning-line.mjs",
    "test": "node --test ../../test/scaffold.test.mjs test/*.test.mjs"
  }
