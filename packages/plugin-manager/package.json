{
  "name": "dsh-life-pack",
  "version": "0.3.5",
  "description": "爱生活总管插件：单 DSH设置面板槽（爱生活卡）+ 爱生活页签槽 children，技能设置页动态聚合，不依赖单品、不 import 单品页",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./dist/client.js",
    "./directory-browser": "./dist/directory-browser-api.js",
    "./directory-browser-ui": "./dist/directory-browser-ui.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "ilife"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeatherHunter/ilife.git",
    "directory": "packages/plugin-manager"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "npm run build:host && npm run build:client",
    "build:host": "tsc -b",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.client.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "dsh-plugin-update": "^0.1.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "react": "19.2.8",
    "tsdown": "0.22.14"
  }
}
