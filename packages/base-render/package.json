{
  "name": "base-paint",
  "version": "0.3.13",
  "description": "渲染包：ui+style+injector+渲染契约，装配唯一 owner",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./blocks": "./dist/blocks.js",
    "./docShell": "./dist/docShell.js",
    "./help-shell": "./dist/helpShell.js",
    "./save-html": "./dist/output/saveHtml.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "base-link-core": "0.3.13"
  },
  "scripts": {
    "build": "tsc -b",
    "gen:help-shell": "node scripts/gen-help-shell.cjs",
    "gen:help-shell:check": "node scripts/gen-help-shell.cjs --check",
    "gate:two-col": "node scripts/check-two-col-align.mjs",
    "gate:two-col-batch": "node scripts/check-two-col-batch.mjs",
    "gate:rendered-text": "node scripts/check-rendered-text.mjs",
    "test": "node --test ../../test/scaffold.test.mjs"
  }
}
